// Prisma schema for NEXUS ARENA
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(uuid())
  username     String             @unique
  email        String             @unique
  passwordHash String
  avatar       String             @default("default_avatar")
  role         String             @default("USER")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stats          PlayerStats?
  participants   MatchParticipant[]
  messages       Message[]
  xpTransactions XPTransaction[]
}

model PlayerStats {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level            Int       @default(1)
  xp               Int       @default(0)
  lifetimeXp       Int       @default(0)
  title            String    @default("Rookie")
  gamesPlayed      Int       @default(0)
  wins             Int       @default(0)
  mvpCount         Int       @default(0)
  currentWinStreak Int       @default(0)
  bestWinStreak    Int       @default(0)
  totalScore       Int       @default(0)
  lastDailyMatchAt DateTime?
  updatedAt        DateTime  @updatedAt
}

model XPTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    String   // "MATCH_COMPLETION" | "PLACEMENT" | "PERFORMANCE" | "DAILY_BONUS"
  gameType  String
  matchId   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([matchId])
}


model Room {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  hostId       String
  gameType     String   @default("Neon Dash")
  status       String   @default("WAITING")
  maxPlayers   Int      @default(8)
  isPrivate    Boolean  @default(false)
  passwordHash String?
  createdAt    DateTime @default(now())
}

model Match {
  id           String             @id @default(uuid())
  roomId       String
  gameType     String             @default("Neon Dash")
  startedAt    DateTime           @default(now())
  endedAt      DateTime?
  winnerId     String?
  participants MatchParticipant[]
}

model MatchParticipant {
  id       String @id @default(uuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  score    Int    @default(0)
  rank     Int    @default(0)
  xpEarned Int    @default(0)
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}
